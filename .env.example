# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Keep disabled until catalog schema, licensed records and media access are approved and verified.
CATALOG_ENABLED=false
# Authentication remains disabled until database writes and the HTTPS endpoint are approved.
AUTH_ENABLED=false
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ==========================================
# DATABASE (NEON POSTGRESQL)
# ==========================================
# Transaction pooler URL for runtime Fastify traffic
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/aadat_db?sslmode=require"
# Direct URL for Prisma migrations & schema validation
DIRECT_DATABASE_URL="postgresql://user:password@ep-sample.region.neon.tech/aadat_db?sslmode=require"

# ==========================================
# CACHE & DISTRIBUTED STATE (REDIS)
# ==========================================
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Secret key for Fastify JWT signing (minimum 64 characters in production)
JWT_SECRET="replace_with_secure_random_64_char_string"
JWT_EXPIRATION="7d"
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="replace_with_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace_with_google_client_secret"

# ==========================================
# AWS S3 STORAGE (PRIVATE ASSETS)
# ==========================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace_with_aws_access_key"
AWS_SECRET_ACCESS_KEY="replace_with_aws_secret_key"
AWS_S3_BUCKET_NAME="aadat-music-media-private"

# ==========================================
# CONTEXTUAL WEATHER API
# ==========================================
OPENWEATHER_API_KEY="replace_with_openweather_api_key"

# ==========================================
# EXTERNAL MUSIC PROVIDERS (JIOSAAVN)
# ==========================================
JIOSAAVN_API_BASE_URL="https://saavn.bycomsolutions.com/api"
# Development-only adapter; rejected when NODE_ENV=production. Does not enable mobile authentication.
MUSIC_PROVIDER=jiosaavn-development

# ==========================================
# MOBILE CLIENT ENVIRONMENT (EXPO)
# ==========================================
# Use 10.0.2.2 for Android Emulator connecting to host machine
EXPO_PUBLIC_GRAPHQL_ENDPOINT="http://10.0.2.2:4000/graphql"
EXPO_PUBLIC_CATALOG_ENABLED=false
EXPO_PUBLIC_SOCKET_ENDPOINT="http://10.0.2.2:4000"

