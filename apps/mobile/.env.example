# ==========================================
# AADAT MUSIC MOBILE CLIENT (EXPO)
# NON-SECRET PUBLIC CONFIGURATION ONLY
# ==========================================
EXPO_PUBLIC_GRAPHQL_ENDPOINT="https://YOUR_API_HOST/graphql"
EXPO_PUBLIC_SOCKET_ENDPOINT="http://localhost:4000"
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Requires a verified HTTPS GraphQL endpoint; never enable against an unapplied schema.
EXPO_PUBLIC_CATALOG_ENABLED=false
# Default off. Set the exact reviewed HTTPS endpoint only after explicit auth/database approval.
EXPO_PUBLIC_AUTH_ENABLED=false
EXPO_PUBLIC_AUTH_VERIFIED_ENDPOINT=""


# Public Web OAuth client ID, matching backend GOOGLE_CLIENT_ID.
# Register Android com.favmusic + signing SHA-1/SHA-256 in the same Google project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# Auth always requires HTTPS. Never add a Google client secret to EXPO_PUBLIC_*.
