{
  "cli": {
    "version": ">= 12.0.0",
    "requireCommit": false,
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-real-songs": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "development-playback-verification",
        "EXPO_PUBLIC_DEVELOPMENT_CATALOG_ENABLED": "true",
        "EXPO_PUBLIC_DEVELOPMENT_CATALOG_ENDPOINT": "https://anyway-pdf-obligation-suggests.trycloudflare.com/development/catalog/graphql",
        "EXPO_PUBLIC_GRAPHQL_ENDPOINT": "https://anyway-pdf-obligation-suggests.trycloudflare.com/graphql",
        "EXPO_PUBLIC_AUTH_ENABLED": "false",
        "EXPO_PUBLIC_CATALOG_ENABLED": "false",
        "EXPO_PUBLIC_ACCOUNT_PERSISTENCE_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
