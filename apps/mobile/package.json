{
  "name": "@aadat/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android-first React Native mobile client for Aadat Music",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "eas:build:android": "EAS_NO_VCS=1 eas build --profile development --platform android",
    "eas:build:preview": "EAS_NO_VCS=1 eas build --profile preview --platform android",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@aadat/contracts": "workspace:*",
    "@babel/runtime": "^7.25.0",
    "@react-native-google-signin/google-signin": "16.1.1",
    "expo": "~52.0.30",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.2",
    "expo-dev-client": "~5.0.9",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-screen-orientation": "~8.0.4",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-video": "~2.0.6",
    "lucide-react-native": "^0.475.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-track-player": "^4.1.2",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@aadat/config": "workspace:*",
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "eas-cli": "^27.2.0",
    "typescript": "^5.7.3"
  }
}
