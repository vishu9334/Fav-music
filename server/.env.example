# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ==========================================
# DATABASE (NEON POSTGRESQL)
# ==========================================
# Transaction pooler URL for runtime Fastify traffic
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations & schema validation
DIRECT_DATABASE_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"
# Node pg clients use dynamic Neon IPv4 resolution with a bounded HTTPS DNS fallback
# and enforce sslmode=verify-full in memory. No OS/global DNS settings are changed.
# Prisma's native CLI has separate networking; validate it before approving migrations.

# ==========================================
# CACHE & DISTRIBUTED STATE (REDIS)
# ==========================================
REDIS_URL="redis://default:password@host:port"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Minimum 64 characters in production
JWT_SECRET="replace-with-a-secure-random-64-character-jwt-secret-key-for-development"
JWT_EXPIRATION="7d"
JWT_ACCESS_EXPIRATION_SECONDS="900"
REFRESH_TOKEN_EXPIRATION_DAYS="7"

# Rate Limiting (Redis-backed distributed protection)
RATE_LIMIT_GLOBAL_MAX="100"
RATE_LIMIT_GLOBAL_TIME_WINDOW_MS="60000"
RATE_LIMIT_AUTH_MAX="10"
RATE_LIMIT_AUTH_TIME_WINDOW_MS="60000"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="replace-with-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# ==========================================
# AWS S3 STORAGE (PRIVATE ASSETS)
# ==========================================
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
AWS_S3_BUCKET_NAME="aadat-music-media-private"

# ==========================================
# CONTEXTUAL WEATHER API
# ==========================================
OPENWEATHER_API_KEY="replace-with-openweather-api-key"

# ==========================================
# EXTERNAL MUSIC PROVIDERS (JIOSAAVN)
# ==========================================
JIOSAAVN_API_BASE_URL="https://saavn.bycomsolutions.com/api"
# Development-only adapter; rejected when NODE_ENV=production. Does not enable mobile authentication.
MUSIC_PROVIDER=jiosaavn-development

# ==========================================
# MOBILE CLIENT ENVIRONMENT
# ==========================================
EXPO_PUBLIC_GRAPHQL_ENDPOINT="http://10.0.2.2:4000/graphql"
EXPO_PUBLIC_SOCKET_ENDPOINT="http://10.0.2.2:4000"


# Executable server entrypoint keeps GraphiQL disabled unless explicitly enabled.
ENABLE_GRAPHIQL=false
